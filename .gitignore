## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

presentation

# .NET Core
project.lock.json
project.fragment.lock.json
/artifacts/

# IDE files
.idea
.vs
*.suo

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# Local generated presentation/workspace scratch
Backup/tmp-*/
Backup/manual-20260503-final-clean/

# Local Docker overrides
docker-compose/.env.local
docker-compose/.env.*.local
docker-compose/secrets/*.local
docker-compose/secrets/*.override

# Real Compose secrets stay local; templates carry the .example.txt suffix.
# Existing dev-default *.txt files remain tracked for now (README marks them
# as starter values to be replaced before deployment).
docker-compose/secrets/*.txt
!docker-compose/secrets/*.example.txt
!docker-compose/secrets/postgres-password.txt
!docker-compose/secrets/postgres-connection.txt
!docker-compose/secrets/minio-access-key.txt
!docker-compose/secrets/minio-secret-key.txt

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# AI / tooling local state
.claude/
.playwright-mcp/
.codegraph/

# Control-plane self-backups written by the compose sidecar
docker-compose/backups/
